# Copy this file to ".env" for local development. Never commit the real ".env" file.

# ---- Ollama Cloud (default — recommended, works the same locally & when hosted) ----
# 1. Create a free API key at https://ollama.com/settings/keys
# 2. Paste it below.
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_API_KEY=your_ollama_cloud_api_key_here

# ---- OR: fully local/offline Ollama instead (no API key needed) ----
# Comment the three lines above and uncomment these two instead:
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# Port the Flask app runs on locally
PORT=5000

# Set to true only for local development to get auto-reload + stack traces
FLASK_DEBUG=true

# ---- Optional free backup AI (recommended) ----
# Free key: https://console.groq.com/keys
# If Ollama fails (out of credits / rate limit / outage), requests go to Groq automatically.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# Set to "groq" to use Groq first and Ollama as the backup:
# AI_PROVIDER=ollama
